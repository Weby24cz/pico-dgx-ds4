# spark-cluster.env — the Weby24cz fork's service settings for THIS cluster (four DGX Sparks,
# straight-cabled ring spark1-spark2-spark3-spark4). Sourced by spark-start.sh / spark-stop.sh /
# spark-restart.sh; the values feed engine/server/service.sh (README-SPARK-CLUSTER.md has the whole
# bring-up). Prepared 2026-11-12; never started — bring-up steps are pending (see the README).

# The fleet file: this cluster's boxes, straight-cable device overrides, addresses, file paths.
export FLEET="$KIT_ROOT/ds41f-4xgx10-switchless/fleet/spark-cluster.conf"

# Serving. Port 8000 is the family rule (ai-api-proxy forwards to spark1:8000; ONE DeepSeek kit
# holds it — stop the TensorFold kit before starting this one). dsfront listens on loopback and the
# head's LAN address (never 0.0.0.0): sparkDash on dell.lan probes http://10.0.0.100:8000/health.
export DSGB10_ADDR="127.0.0.1 10.0.0.100"
export DSGB10_PORT=8000

# API key, generated at bring-up: (umask 077; openssl rand -hex 24 > ~/dsgb10-data/api-key).
# dsfront serves /health unauthenticated; /v1/* needs the bearer key (sparkDash's probe does not).
export DSGB10_KEY_FILE="$HOME/dsgb10-data/api-key"

# The front-end: the 1017 checkpoint's tokenizer (the repo default names the uncensored variant),
# its chat encoding (--encoding 1017: tool namespaces, reasoning kept across tool-call turns) and
# the family's served name — ai-api-proxy registers it with the same name and aliases
# (ds41 ds41-fast ds41-coder-low ds41-coder-high ds41-coder-max benchmark-model vscode-utility
# vscode-utility-small), whose per-alias presets stay in ai-api-proxy.
export DSGB10_FRONT_ARGS="--tokenizer $HOME/ai/models/hub/models--deepseek-ai--DeepSeek-V4.1-Flash-1017/snapshots/1bae0e1088993b9b82de08f59de5be5a34e42170/tokenizer.json --encoding 1017 --model-name DeepSeek-V4.1-Flash-1017"

# The engine. The README's recommended block, made strictly lossless (the family's serving rule):
# DSGB10_OEA (batch-aware expert re-route) dropped — lossless multi-user, ~364 tok/s at 16 distinct
# users instead of ~376. DSGB10_RING_DIRECT=2 stays OUT: it is for a switched fabric, this cluster
# is the switchless cabled ring. Kept: 1M context, 16 slots (4 x 1M, 12 x 128K), shared drafts,
# one-pass drafter, wide 64-row steps with the cost gate, the 4-bit one-user draft head, the learned
# verify gate (~/cfmlp_cml.bin — the gate weights from tools/stack4/, on ALL FOUR boxes), the
# certified LM head. The checkpoint the numbers were measured on is ours: 1017 @ 1bae0e10.
export DSGB10_ENGINE_ARGS="--max-ctx 1048576 --slots 16 --big-slots 4 \
  --setenv DSGB10_BUDGET=1 --setenv DSGB10_DRAFT1=6 --setenv DSGB10_WIDE=64 \
  --setenv DSGB10_WIDE_COST=24,2.2,57,1.1 \
  --draft-head4 --draft-markov8 --setenv DSGB10_HEAD4_C1=1 \
  --setenv DSGB10_CF_MLP=~/cfmlp_cml.bin --setenv DSGB10_CF_ALPHA=1.0 \
  --setenv DSGB10_CERT=1"

# service.sh wants 100 GiB free on every box before a start (MIN_AVAIL_GIB). Today spark3 has
# ~187 GiB: after its rank file (~78 GiB) and Engram shards (~51 GiB) bake it holds ~58 GiB — a
# start would refuse there. Free space on spark3 (or move its rank files to another disk) BEFORE
# the first start; do not lower this instead.
export MIN_AVAIL_GIB=100
